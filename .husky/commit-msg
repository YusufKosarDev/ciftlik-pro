# Husky 9: no shebang and no preamble; .husky/_/h runs this file with `sh -e` and
# passes the commit message file's path as $1.
#
# The pattern list is deliberately NOT here: the single source of truth is the
# script below. CI runs the same check through the same script.
sh "$(git rev-parse --show-toplevel)/scripts/check-commit-messages.sh" --message-file "$1"
