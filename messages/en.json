  "Landing": {
    "kicker": "Multi-tenant SaaS · Farm ERP",
    "title": "Run a whole farm from one role-based dashboard.",
    "subtitle": "Çiftlik Pro is a multi-tenant farm management system. Every owner signs up, gets a fully isolated tenant, and runs livestock, fields, inventory, finance, sales, a public storefront, tasks and staff from one place. It is a portfolio project, and the demo below is the real application.",
    "signIn": "Sign in",
    "storefront": "Farm storefront",
    "createFarm": "Create your farm",
    "source": "Source",
    "backHome": "Back to the home page",
    "license": "MIT licensed",
    "demoTitle": "Try it as any of the four roles",
    "demoBody": "No sign-up. Each account is read-only, and each button says what that role cannot reach — a narrower menu is a permission boundary, not a broken page.",
    "demoHint": "All four see the same farm. The refusal is a real HTTP redirect from the edge, not a client-side bounce.",
    "shotDashboard": "Dashboard — summary cards with real month-over-month deltas and a monthly income/expense chart",
    "shotAnimal": "Animal detail — milk yield and weight trends, health history and lineage",
    "shotStore": "The public per-tenant storefront, with a slug-scoped cart and multi-line orders",
    "highlightsTitle": "What is worth a closer look",
    "isolationTitle": "Tenant isolation, enforced twice",
    "isolationBody": "PostgreSQL Row-Level Security plus a Prisma client extension. The tenant context is set with SET LOCAL inside an interactive transaction, so it survives a connection pooler. CI proves it on every push under a role that cannot bypass RLS.",
    "rbacTitle": "One authorization source, three levels",
    "rbacBody": "Four roles, one write matrix, applied at the edge proxy, on server pages and on every write endpoint. A section outside your role is refused with a real 307 before anything renders.",
    "testedTitle": "Checked, not asserted",
    "testedBody": "Unit, integration and end-to-end suites run on every push across three parallel CI jobs, including tenant isolation against a real PostgreSQL instance.",
    "bilingualTitle": "Bilingual end to end",
    "bilingualBody": "Every screen and every API error message in Turkish and English. A first-time visitor gets their browser's language; the switcher pins a choice from then on.",
    "readMore": "The reasoning, the alternatives that were rejected and the known limitations are written down in <repo>the repository</repo>."
  },
