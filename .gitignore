# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
docker_build*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Next 16.3 yazar: `next dev` her calistiginda depo kokune AGENTS.md ve CLAUDE.md
# uretir (node_modules/next/dist/server/lib/generate-agent-files.js) ve silinince
# yeniden olusturur. Icerikleri Next'in kendi paketinden turer, bu deponun bir
# parcasi degildir; herkese acik bir depoya yazmadigimiz talimat dosyalari
# eklemek yerine yok sayiyoruz.
/AGENTS.md
/CLAUDE.md
